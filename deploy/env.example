# Environment for the Coolify service. Set these as service environment variables
# in Coolify — do not commit a filled-in copy of this file.

# WebAuthn relying-party ID: the exact hostname, no scheme, no port.
# Changing this invalidates every passkey already registered.
RP_ID=gym.fnsalinas.io
ORIGIN=https://gym.fnsalinas.io
RP_NAME=openGym

# Open signup while the first profile is registered, then switch to 1.
INVITE_ONLY=0

# Comma-separated user ids that get the admin dashboard.
# Read the id from data/db.json (users[].id) after registering.
ADMIN_UIDS=

# Session lifetime in days.
SESSION_DAYS=30

# Contact URI sent with web-push notifications.
VAPID_SUBJECT=mailto:you@example.com
